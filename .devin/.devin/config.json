{
  "git": {
    "autoCommit": true,
    "commitMessagePrefix": "feat:",
    "allowForcePush": false,
    "allowBranchDeletion": false,
    "allowedBranches": ["main", "master", "develop"],
    "skipHooks": false
  },
  "permissions": {
    "allowDestructiveOperations": false,
    "allowDatabaseOperations": true,
    "allowConfigChanges": true,
    "allowDependencyInstallation": true,
    "allowFileCreation": true,
    "allowFileModification": true,
    "allowFileDeletion": true
  },
  "project": {
    "type": "laravel-vue",
    "defaultBranch": "main",
    "testCommand": "php artisan test",
    "buildCommand": "npm run build",
    "devCommand": "composer run dev"
  },
  "hooks": {
    "beforeCommit": null,
    "afterCommit": null,
    "beforePush": null,
    "afterPush": null
  }
}